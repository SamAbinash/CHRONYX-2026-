# ==============================================================================
# CHRONYX 2026 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' or '.env.local' to customize configuration.
# DO NOT commit production secrets to public source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ORGANIZER AUTHENTICATION (Protected Dashboard Login & CSV Export)
# ------------------------------------------------------------------------------
# Credentials for organizer login at /admin or /organizer:
VITE_ADMIN_EMAIL=your_admin_email@example.com
VITE_ADMIN_PASSWORD=your_secure_admin_password_here

# Secret passkey for programmatic admin access & exports:
VITE_ORGANIZER_ACCESS_KEY=your_organizer_access_secret_here

# ------------------------------------------------------------------------------
# 2. STORAGE BACKEND MODE
# ------------------------------------------------------------------------------
# Options:
# - 'local'    : Uses browser IndexedDB (stores screenshots & records safely offline)
# - 'supabase' : Uses cloud PostgreSQL database + Supabase Storage bucket
# - 'custom_api' : Connects to custom REST API backend (e.g. Node/Express, Django, Flask)
VITE_STORAGE_BACKEND=local

# ------------------------------------------------------------------------------
# 3. SUPABASE CONFIGURATION (Optional - for cloud PostgreSQL & Storage)
# ------------------------------------------------------------------------------
# If deploying to Supabase:
# 1. Create a free project at https://supabase.com
# 2. Run the SQL table definition below in the Supabase SQL Editor
# 3. Create a Storage Bucket named 'payment_screenshots' with private access
# 4. Fill in your project URL and Anon Key below:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_BUCKET=payment_screenshots

# ------------------------------------------------------------------------------
# 4. CUSTOM BACKEND API (Optional - if using custom REST backend)
# ------------------------------------------------------------------------------
# Base URL for custom registration submission and verification endpoints:
VITE_API_BASE_URL=https://api.yourcollege.edu/chronyx2026

